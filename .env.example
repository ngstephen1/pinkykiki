# Only the Node server reads this file. Never put this key in browser JavaScript.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_WEB_SEARCH=true
# Optional: multiline private preferences for Vercel (never use a public/client prefix).
MILO_PERSONAL_CONTEXT=
# Optional: stable session signing key. Defaults to a server-only key derived from OPENAI_API_KEY.
MILO_SESSION_SECRET=
PORT=8000
HOST=127.0.0.1
